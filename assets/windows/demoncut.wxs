<?xml version="1.0" encoding="UTF-8"?>
<!--
  Demon Cut's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.7 -d Root=C:\...\Demon Cut
              -d Stage=C:\...\stage\DemonCut-0.2.7-windows-x86_64
              -o stage\DemonCut-0.2.7-windows-x86_64.msi assets\windows\demoncut.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="Demon Cut"
           Manufacturer="Demon Cut contributors"
           Version="$(var.Version)"
           UpgradeCode="B46A45F5-FDA1-4025-AE5C-6487BA65C35A"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Demon Cut is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="demoncut.ico" SourceFile="$(var.Root)\assets\icons\demoncut.ico" />
    <Property Id="ARPPRODUCTICON" Value="demoncut.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/DaftHD/Demon-Cut" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Demon Cut" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Demon Cut" />
    </StandardDirectory>

    <Feature Id="Main" Title="Demon Cut" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="E515A865-AB07-4103-A61C-9764FA0375EA">
      <Shortcut Id="StartMenuShortcut"
                Name="Demon Cut"
                Description="Video editor"
                Target="[INSTALLFOLDER]demoncut.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="demoncut.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Demon Cut" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
