# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=demoncut
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/DaftHD/Demon-Cut"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/demoncut" "$pkgdir/opt/demoncut/demoncut"
  install -d "$pkgdir/opt/demoncut/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/demoncut/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/demoncut/demoncut "$@"\n' > "$pkgdir/usr/bin/demoncut"
  chmod 755 "$pkgdir/usr/bin/demoncut"
  install -Dm644 "$stage/demoncut.desktop" "$pkgdir/usr/share/applications/demoncut.desktop"
  sed -i 's|^Exec=demoncut|Exec=/opt/demoncut/demoncut %U|' "$pkgdir/usr/share/applications/demoncut.desktop"
  install -Dm644 "$stage/demoncut.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/demoncut.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/demoncut/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/demoncut/THIRD_PARTY_NOTICES.md"
}
